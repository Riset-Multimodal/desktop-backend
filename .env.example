DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Auth (wajib) ---
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# bcrypt hash dari password bersama peserta:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'PASSWORD_BARU', bcrypt.gensalt()).decode())"
SHARED_PASSWORD_HASH=
# Key admin untuk GET /users dan list semua response (header X-API-Key)
ADMIN_API_KEY=

# CORS (JSON list). Default ["*"] aman karena auth pakai Bearer token, bukan cookie.
# CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=posture
SUPABASE_SIGNED_URL_TTL=3600

# Tulis analysis_history.json / global_average.json / CSV (pipeline lama)
LEGACY_FILE_LOGS=false
